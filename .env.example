# Optional: copy to .env locally. Never commit .env or real credentials.
HOST=127.0.0.1
PORT=4310
# Leave empty for loopback-only local use. AI is intentionally unconfigured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required together for owner login; required in production.
# OWNER_PASSWORD must be nonempty (up to 1024 characters); SESSION_SECRET at least 32.
OWNER_PASSWORD=
SESSION_SECRET=
# Production requires the exact public HTTPS origin (no path).
# APP_ORIGIN=https://instrument.example.com
# DATABASE_PATH=./data/vibeconductor.sqlite

# Optional per-million token price overrides for custom model cost estimates.
# Defaults for gpt-4.1-mini: input 0.40, output 1.60 USD.
# Unknown models have no estimate unless both are specified.
# OPENAI_INPUT_PRICE_PER_MILLION=0.40
# OPENAI_OUTPUT_PRICE_PER_MILLION=1.60
